        "assignments": {
          "assignments": [
            {
              "id": "0e89f082-1648-4e06-afb0-1f07eebdb6d0",
              "name": "site",
              "value": "https://quotes.toscrape.com/",
              "type": "string"
            },
            {
              "id": "cc6d8fb7-abd8-45c2-a3d1-fdf1a5ba2a35",
              "name": "search",
              "value": "/author/",
              "type": "string"
            },
            {
              "id": "f3518b53-22bb-4320-ae84-ad97175f346c",
