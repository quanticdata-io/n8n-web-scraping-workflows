    {
      "parameters": {
        "method": "POST",
        "url": "https://api.quanticdata.io/v1/scraper/map",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"url\": \"{{ $json.site }}\",\n  \"search\": \"{{ $json.search }}\",\n  \"limit\": {{ $json.limit }}\n}",
        "options": {
          "timeout": 180000
        }
      },
      "name": "Map site",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        100
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "id": "aba2a921-0c96-4134-a8dc-9f6b0203a874"
    },
    {
      "parameters": {
        "jsCode": "const map = $input.first().json.payload;\nconst urls = map.links || [];\nif (urls.length === 0) {\n  throw new Error('The map call found no URLs for ' + map.url + '. Check the site and the search filter.');\n}\nreturn [{ json: { urls, total_on_site: map.total } }];"
      },
      "name": "URLs to scrape",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        100
      ],
      "id": "8ed23291-f2f7-4279-a5b2-a5657863ead1"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.quanticdata.io/v1/scraper/batch",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
