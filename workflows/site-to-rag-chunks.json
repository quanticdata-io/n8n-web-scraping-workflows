      "id": "0f09f884-cc72-4924-afbb-e1f9754d74d7"
    },
    {
      "parameters": {
        "jsCode": "// Splits each page at its Markdown headings, then cuts long sections to maxChunkChars.\nconst job = $input.first().json.payload;\nconst max = $('Settings').first().json.maxChunkChars;\nconst lines = [];\nfor (const item of job.items || []) {\n  if (!item.content || item.status >= 400) continue;\n  let heading = item.title || '';\n  let buffer = [];\n  let index = 0;\n  const flush = () => {\n    const text = buffer.join('\\n').trim();\n    buffer = [];\n    for (let start = 0; start < text.length; start += max) {\n      lines.push(JSON.stringify({ url: item.url, title: item.title, heading, chunk: index++, text: text.slice(start, start + max) }));\n    }\n  };\n  for (const line of item.content.split('\\n')) {\n    const m = /^#{1,6}\\s+(.*)$/.exec(line);\n    if (m) {\n      flush();\n      heading = m[1].replace(/\\[([^\\]]*)\\]\\([^)]*\\)/g, '$1').trim();\n    }\n    buffer.push(line);\n  }\n  flush();\n}\nreturn [{\n  json: {\n    jsonl: lines.join('\\n') + '\\n',\n    chunks: lines.length,\n    pages: (job.items || []).length,\n    failed: job.failed,\n    more_items_withheld: job.hasMore,\n  },\n}];"
      },
      "name": "Chunk for RAG",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
